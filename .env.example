# KenyaTrace — Environment template
# Copy to .env.local and fill real values. Never commit .env.local (gitignored).
# Dashboard sources: Convex (NEXT_PUBLIC_CONVEX_URL, CONVEX_DEPLOY_KEY), Clerk (CLERK_*),
# OpenRouter, Firecrawl, Resend, Paystack, Vercel/Github for deploy.py

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_DEPLOY_KEY=dev:your-deployment|paste_from_convex_dashboard

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...

# Scraper
FIRECRAWL_API_KEY=fc-...

# Resend (email invites + reminders)
RESEND_API_KEY=re_...
EMAIL_FROM=KenyaTrace <noreply@your-verified-domain.com>
RECOVERY_EMAIL=support@your-verified-domain.com

# Paystack (use TEST keys for dev, LIVE only in Vercel/Convex prod env)
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# For prod: set PAYSTACK_SECRET_KEY + NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY as LIVE keys
# in Convex + Vercel dashboard, NOT in .env.local

# App URL (used for invite links + OG metadata)
NEXT_PUBLIC_APP_URL=https://kenyatrace.vercel.app

# Deployment helpers (deploy.py only — keep out of Vercel/Convex)
VERCEL_TOKEN=vcp_...
GITHUB_TOKEN=ghp_...
# VERCEL_PROJECT_ID / VERCEL_TEAM_ID auto-detected from .vercel/project.json
